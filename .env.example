# ── Service Ports ─────────────────────────────────────────────
AUTH_SERVICE_PORT=8080
SIMULATION_SERVICE_PORT=8081
REGULATION_SERVICE_PORT=8082

# ── Database (regulation-service) ─────────────────────────────
# Datasource 사용 시 (application.yml의 exclude 제거) 아래 값 사용
DB_URL=jdbc:mysql://localhost:3306/hwalro?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=password

# ── Spring AI (simulation-service, regulation-service) ────────
# Spring AI 사용 시 (application.yml의 exclude 제거) 아래 값 사용
OPENAI_API_KEY=
