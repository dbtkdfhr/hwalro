# ── Service Ports ─────────────────────────────────────────────
AUTH_SERVICE_PORT=8080
SIMULATION_SERVICE_PORT=8081
REGULATION_SERVICE_PORT=8082

# ── Database (각 서비스 전용 DB/계정) ──────────────────────────
# docker-compose.yml의 단일 MySQL에 서비스별 DB 3개 + 전용 계정 3개가 생성됨
# 각 서비스는 자기 DB 전용 계정으로만 접속한다 (다른 서비스 DB 접근 불가)
AUTH_DB_URL=jdbc:mysql://localhost:3307/hwalro_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AUTH_DB_USERNAME=hwalro_auth
AUTH_DB_PASSWORD=hwalro_auth
REGULATION_DB_URL=jdbc:mysql://localhost:3307/hwalro_regulation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
REGULATION_DB_USERNAME=hwalro_regulation

# MySQL 컨테이너 초기화 값 (docker-compose.yml에서 사용)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hwalro_auth
MYSQL_PORT=3307
SIMULATION_DB_PASSWORD=hwalro_simulation
REGULATION_DB_URL=jdbc:mysql://localhost:3307/hwalro_regulation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
REGULATION_DB_USERNAME=hwalro_regulation
REGULATION_DB_PASSWORD=hwalro_regulation
AUTH_SERVICE_URL=http://localhost:8080

# 스키마 자동 초기화 (auth-service, regulation-service). 개발에서만 always 사용 (CREATE IF NOT EXISTS)
DB_INIT_MODE=never

# ── Redis (auth-service) ──────────────────────────────────────
# Refresh Token(RTR) 저장소. docker-compose.yml 기준 6380 포트 매핑 (127.0.0.1 바인딩)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=hwalro-dev-redis
REDIS_TIMEOUT=3s

# ── JWT (auth-service) ────────────────────────────────────────
# 운영 환경에서는 반드시 임의의 긴 문자열로 교체할 것 (HS256 서명 키, 32바이트 이상)
JWT_SECRET=dev-only-secret-key-change-me-in-production-0123456789abcdef
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_ISSUER=hwalro-auth-service

# ── Cookie (auth-service) ─────────────────────────────────────
# 운영(HTTPS) 환경에서는 Secure=true, SameSite=Strict 권장
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false

# ── CORS (auth-service) ───────────────────────────────────────
# 프론트엔드 개발 서버 주소 (쉼표로 여러 개 지정 가능)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173

# ── Spring AI (regulation-service) ─────────────────────────────
# 실제 키는 .env.example에 기록하지 않고 로컬 .env 또는 실행 환경 변수에만 설정한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_MAX_COMPLETION_TOKENS=1800
OPENAI_RETRY_MAX_ATTEMPTS=3
