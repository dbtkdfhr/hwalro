<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hwalro.simulation.analysis.mapper.BottleneckAnalysisMapper">

    <select id="findDensityThreshold"
            resultType="com.hwalro.simulation.analysis.mapper.BottleneckAnalysisMapper$DensityThresholdRow">
        SELECT threshold_value AS thresholdValue,
               unit
        FROM density_threshold_settings
        WHERE id = 1
    </select>

</mapper>
