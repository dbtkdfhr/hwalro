REGISTRY_URL=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/hwalro
AUTH_TAG=latest
SIMULATION_TAG=latest
REGULATION_TAG=latest
GATEWAY_PORT=80
AUTH_DB_URL=jdbc:mysql://your-rds-endpoint:3306/hwalro_auth?sslMode=REQUIRED&serverTimezone=Asia/Seoul
AUTH_DB_USERNAME=hwalro_auth
AUTH_DB_PASSWORD=change-me-prod-auth-password
SIMULATION_DB_URL=jdbc:mysql://your-rds-endpoint:3306/hwalro_simulation?sslMode=REQUIRED&serverTimezone=Asia/Seoul
SIMULATION_DB_USERNAME=hwalro_simulation
SIMULATION_DB_PASSWORD=change-me-prod-simulation-password
REGULATION_DB_URL=jdbc:mysql://your-rds-endpoint:3306/hwalro_regulation?sslMode=REQUIRED&serverTimezone=Asia/Seoul
REGULATION_DB_USERNAME=hwalro_regulation
REGULATION_DB_PASSWORD=change-me-prod-regulation-password
REDIS_PASSWORD=change-me-prod-redis-password
REDIS_TIMEOUT=3s
JWT_SECRET=change-me-prod-jwt-secret-min-32-chars-long-string
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_ISSUER=hwalro-auth-service
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://your-domain.com
AUTH_SERVICE_CONNECT_TIMEOUT=2s
AUTH_SERVICE_READ_TIMEOUT=5s
DB_INIT_MODE=never
SPRING_PROFILES_ACTIVE=ai
LAW_API_OC=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_MAX_COMPLETION_TOKENS=1800
OPENAI_RETRY_MAX_ATTEMPTS=3
