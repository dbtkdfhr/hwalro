# Copy this file to deploy/.env.rds-init on EC2, fill in the real values,
# and delete the copied file after the one-time initialization succeeds.
RDS_HOST=your-rds-endpoint
RDS_PORT=3306
RDS_ADMIN_USERNAME=admin
RDS_ADMIN_PASSWORD=change-me-rds-admin-password
AUTH_DB_PASSWORD=change-me-prod-auth-password
SIMULATION_DB_PASSWORD=change-me-prod-simulation-password
REGULATION_DB_PASSWORD=change-me-prod-regulation-password
