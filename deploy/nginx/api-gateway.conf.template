server {
    listen 80;
    server_name _;

    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/auth {
        proxy_pass http://${AUTH_SERVICE_URL};
    }

    location /api/admin {
        proxy_pass http://${AUTH_SERVICE_URL};
    }

    location /api/drawings {
        proxy_pass http://${SIMULATION_SERVICE_URL};
    }

    location /api/simulations {
        proxy_pass http://${SIMULATION_SERVICE_URL};
    }

    location /api/simulation-results {
        proxy_pass http://${SIMULATION_SERVICE_URL};
    }

    location /api/layout-searches {
        proxy_pass http://${SIMULATION_SERVICE_URL};
    }

    location /api/regulations {
        proxy_pass http://${REGULATION_SERVICE_URL};
    }

    location /api/reports {
        proxy_pass http://${REGULATION_SERVICE_URL};
    }

    location /api/risks {
        proxy_pass http://${REGULATION_SERVICE_URL};
    }

    location /api/safety-checks {
        proxy_pass http://${REGULATION_SERVICE_URL};
    }

    location / {
        return 404;
    }
}
