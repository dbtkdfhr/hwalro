{
  "name": "hwalro",
  "private": true,
  "scripts": {
    "dev": "turbo dev --ui tui",
    "build": "turbo build",
    "lint": "turbo lint",
    "check:deploy": "node ./scripts/verify-deploy-contract.mjs",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "infra": "docker compose up -d --wait && node ./scripts/load-dev-test-data.mjs",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:migrate:auth-roles": "node ./scripts/migrate-auth-roles.mjs",
    "engine:setup": "node ./scripts/setup-simulation-engine.mjs",
    "reset": "pnpm infra:reset && pnpm infra && node ./scripts/migrate-auth-roles.mjs --retry"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.4.4",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
